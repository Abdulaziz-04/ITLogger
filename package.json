{
  "name": "opsdesk",
  "version": "2.0.0",
  "description": "Modernized OpsDesk incident logger API + client",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "client": "npm start --prefix front",
    "client:install": "npm install --prefix front",
    "client:build": "npm run build --prefix front",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "seed:db": "node backend/seed.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "config": "^3.3.11",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "joi": "^17.11.0",
    "mongoose": "^8.6.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.1"
  },
  "proxy": "http://localhost:5000"
}
